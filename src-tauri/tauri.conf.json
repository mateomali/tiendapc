{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sudoku Admin",
  "version": "0.1.0",
  "identifier": "com.sudokumerlo.admin",
  "build": {
    "frontendDist": "https://www.sudokumerlo.com/admin",
    "devUrl": "https://www.sudokumerlo.com/admin"
  },
  "app": {
    "windows": [
      {
        "title": "Sudoku Admin",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sudoku Merlo",
    "shortDescription": "Panel de administracion de Sudoku Merlo.",
    "longDescription": "Aplicacion de escritorio para administrar tienda, reparaciones, ventas y contenidos de Sudoku Merlo.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
